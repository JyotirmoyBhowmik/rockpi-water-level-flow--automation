# ==============================================================================
# Radxa ROCK Pi S Smart Water & Precision Irrigation Controller Environment Config
# ==============================================================================

# Hardware Operating Mode
# Set to 'true' to run fully virtualized mock drivers (sandbox/dev)
# Set to 'false' to interface directly with Linux /dev/gpiochip1, /dev/i2c-7, /dev/watchdog
MOCK_HARDWARE=true

# Server Network Configuration (Private mesh access via Tailscale / Headscale)
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Linux Device Nodes
GPIO_CHIP_PATH=/dev/gpiochip1
I2C_BUS=7
I2C_DEV_PATH=/dev/i2c-7
WATCHDOG_DEV_PATH=/dev/watchdog
WATCHDOG_TIMEOUT_SEC=10
WATCHDOG_PET_INTERVAL_SEC=3

# Hardware Pin Allocation (ROCK Pi S Header 1, gpiochip1)
PIN_TANK_LOW_FLOAT=10
PIN_TANK_HIGH_FLOAT=11
PIN_RESERVOIR_LOW_FLOAT=12
PIN_AC_CONTACTOR=13
PIN_ZONE_1_MOSFET=15
PIN_ZONE_2_MOSFET=22
PIN_ZONE_3_MOSFET=23
PIN_ZONE_4_MOSFET=24

# ADS1115 I2C ADC Configuration
ADS1115_I2C_ADDR=0x48

# Audio & Voice Alerts (ALSA + espeak-ng over USB audio dongle)
AUDIO_ENABLED=true
ALSA_DEVICE=default
ESPEAK_VOICE=en-us
ESPEAK_SPEED=155

# Safety Interlock Guard Parameters (Priority 0)
MAX_AC_MOTOR_RUNTIME_SEC=900
MAX_DC_PUMP_RUNTIME_SEC=120
SENSOR_VOLTAGE_MIN_V=0.5
SENSOR_VOLTAGE_MAX_V=3.0
ZONE_COOLDOWN_SEC=21600

# SQLite Persistence & Memory Budget
SMART_WATER_DATA_DIR=./data
SQLITE_CACHE_SIZE_KB=-2000
TELEMETRY_RETENTION_HOURS=48
