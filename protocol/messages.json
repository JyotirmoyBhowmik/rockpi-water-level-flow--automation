{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartWaterProtocolV1_1",
  "description": "JSON Lines binary/serial contract between ROCK Pi S Controller and ESP32-C3 Garden Node",
  "canonical_rules": {
    "description": "Deterministic canonical string format shared between Python and C++ without re-serializing parsed JSON",
    "separator_comma": ",",
    "separator_colon": ":",
    "no_spaces": true,
    "no_sig_in_unsigned": true,
    "floats_format": "%.3f",
    "integers_format": "plain integer (no scientific notation)",
    "booleans_format": "true or false",
    "signing_algorithm": "HMAC-SHA256 truncated to first 16 lowercase hex characters",
    "verification_rule": "Locate ',\"sig\":\"<16hex>\"}' suffix textually, strip it and restore trailing '}' to obtain exact original bytes for HMAC verification"
  },
  "fixed_key_orders": {
    "hb": [
      "v",
      "t",
      "nonce",
      "seq",
      "uptime_s",
      "res_wet",
      "ads_ok",
      "pumps",
      "reset_reason",
      "rssi"
    ],
    "soil": [
      "v",
      "t",
      "nonce",
      "seq",
      "z",
      "volts"
    ],
    "flow": [
      "v",
      "t",
      "nonce",
      "seq",
      "z",
      "delta_pulses",
      "period_ms"
    ],
    "pump": [
      "v",
      "t",
      "nonce",
      "seq",
      "z",
      "on",
      "reason",
      "run_s"
    ],
    "ack": [
      "v",
      "t",
      "nonce",
      "seq",
      "id",
      "status",
      "err"
    ],
    "cmd": [
      "v",
      "t",
      "nonce",
      "seq",
      "id",
      "z",
      "run_s"
    ],
    "stop": [
      "v",
      "t",
      "nonce",
      "seq",
      "id",
      "z"
    ],
    "stop_all": [
      "v",
      "t",
      "nonce",
      "seq",
      "id"
    ]
  },
  "type": "object",
  "required": [
    "v",
    "t",
    "nonce",
    "seq",
    "sig"
  ],
  "properties": {
    "v": {
      "type": "string",
      "enum": [
        "1.1"
      ],
      "description": "Protocol version identifier"
    },
    "t": {
      "type": "string",
      "enum": [
        "hb",
        "soil",
        "flow",
        "pump",
        "cmd",
        "stop",
        "stop_all",
        "ack",
        "gw_init",
        "gw_hb",
        "gw_err"
      ],
      "description": "Packet message type"
    },
    "nonce": {
      "type": "integer",
      "minimum": 0,
      "description": "Random 32-bit boot nonce generated at boot session start"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Strictly monotonic packet sequence number per boot session"
    },
    "sig": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "First 16 hexadecimal chars of HMAC-SHA256 over fixed-order canonical string"
    }
  },
  "golden_vectors": [
    {
      "name": "heartbeat_packet",
      "t": "hb",
      "secret_key": "test-secret-key-32-chars-long12345",
      "unsigned": "{\"v\":\"1.1\",\"t\":\"hb\",\"nonce\":1001,\"seq\":1,\"uptime_s\":120,\"res_wet\":true,\"ads_ok\":true,\"pumps\":[0,0,0,0],\"reset_reason\":1,\"rssi\":-65}",
      "sig": "3d4a199760f47ebf",
