[Unit]
Description=Radxa ROCK Pi S Smart Water & Precision Irrigation Controller
Documentation=https://github.com/radxa/rockpis
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
RequiresMountsFor=/opt/smart-water /var/lib/smart-water /etc/smart-water

[Service]
Type=simple
User=smartwater
Group=smartwater
SupplementaryGroups=gpio i2c dialout audio
WorkingDirectory=/opt/smart-water
ExecStart=/opt/smart-water/venv/bin/python /opt/smart-water/run.py
Restart=always
RestartSec=3s

# ==============================================================================
# HARDENED MEMORY CGROUPS & WATCHDOG LIMITS (<35MB RUNTIME BUDGET)
# ==============================================================================
MemoryAccounting=yes
MemoryHigh=35M
MemoryMax=45M

# Watchdog Keep-Alive Ping (Hardware /dev/watchdog and sd_notify)
WatchdogSec=15s

# Environment configuration
Environment=PYTHONUNBUFFERED=1
Environment=SMART_WATER_CONFIG=/etc/smart-water/config.yaml
Environment=SMART_WATER_DATA_DIR=/var/lib/smart-water

# Security Sandbox Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smart-water /run/smart-water /etc/smart-water

# Hardware Device Permissions
DeviceAllow=/dev/gpiochip* rw
DeviceAllow=/dev/i2c-* rw
DeviceAllow=/dev/garden-gateway rw
DeviceAllow=/dev/ttyUSB* rw
DeviceAllow=/dev/ttyACM* rw
DeviceAllow=/dev/watchdog rw
DeviceAllow=/dev/snd/* rw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-water

[Install]
WantedBy=multi-user.target
