[Unit]
Description=Radxa ROCK Pi S Smart Water & Precision Irrigation Controller
Documentation=https://github.com/radxa/rockpis
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
RequiresMountsFor=/opt/smart-water

[Service]
Type=simple
User=root
WorkingDirectory=/opt/smart-water
ExecStart=/opt/smart-water/venv/bin/python /opt/smart-water/run.py
Restart=always
RestartSec=3s

# ==============================================================================
# HARDENED MEMORY CGROUPS & WATCHDOG LIMITS (<35MB RUNTIME BUDGET)
# ==============================================================================
MemoryAccounting=yes
MemoryHigh=35M
MemoryMax=45M

# Kernel Watchdog Keep-Alive Ping
WatchdogSec=10s

# Environment configuration
Environment=PYTHONUNBUFFERED=1
Environment=MOCK_HARDWARE=false
Environment=SMART_WATER_DATA_DIR=/opt/smart-water/data

# Security Sandbox Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

# Hardware Device Permissions (Rock Pi S Header 1, I2C7, Watchdog, Audio)
DeviceAllow=/dev/gpiochip1 rw
DeviceAllow=/dev/i2c-7 rw
DeviceAllow=/dev/watchdog rw
DeviceAllow=/dev/snd/* rw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-water

[Install]
WantedBy=multi-user.target
