[Unit]
Description=Radxa ROCK Pi S Smart Water & Precision Irrigation Controller
Documentation=https://github.com/radxa/rockpis
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
RequiresMountsFor=/opt/smart-water

[Service]
Type=notify
NotifyAccess=main
User=smartwater
Group=smartwater
SupplementaryGroups=gpio i2c dialout audio
WorkingDirectory=/opt/smart-water
ExecStart=/opt/smart-water/venv/bin/python /opt/smart-water/run.py
Restart=always
RestartSec=3s
TimeoutStartSec=60
TimeoutStopSec=10
KillSignal=SIGTERM

# ==============================================================================
# MEMORY CGROUPS & WATCHDOG LIMITS (Relaxed to 128M / 200M)
# ==============================================================================
MemoryAccounting=yes
MemoryHigh=128M
MemoryMax=200M

# Watchdog Keep-Alive Ping (Hardware /dev/watchdog and sd_notify)
WatchdogSec=15s

# Automatic systemd state and runtime directory provisioning
StateDirectory=smart-water
RuntimeDirectory=smart-water
ReadWritePaths=/var/lib/smart-water /run/smart-water

# Environment configuration
Environment=PYTHONUNBUFFERED=1
Environment=SMART_WATER_CONFIG=/etc/smart-water/config.yaml
Environment=SMART_WATER_DATA_DIR=/var/lib/smart-water

# Security Sandbox Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true

# Hardware Device Permissions
DevicePolicy=closed
DeviceAllow=char-gpiochip rw
DeviceAllow=char-i2c rw
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-watchdog rw
DeviceAllow=char-alsa rw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-water

[Install]
WantedBy=multi-user.target
